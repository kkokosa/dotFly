<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ML.NET readout adapter for dotFly — wrap a trained ML.NET model as a readout over an output port's feature vector, plus helpers to train one from recorded frames.</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotFly.Engine\DotFly.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" />
  </ItemGroup>

</Project>
