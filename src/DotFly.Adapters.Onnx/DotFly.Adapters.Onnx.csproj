<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ONNX Runtime readout adapter for dotFly — run any trained model (PyTorch, ML.NET, scikit-learn exports) over an output port's feature vector.</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotFly.Engine\DotFly.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

</Project>
